# Self-hosted Umami (https://github.com/umami-software/umami).
# Public tracker origin; HTTPS in production. Do not include /script.js or /api.
UMAMI_URL=
# Website UUID from Umami settings (public).
UMAMI_WEBSITE_ID=
# Server-only Umami API key/Bearer token authorized to read this website.
# Enter the real value in deployment secret settings; never commit it.
UMAMI_API_TOKEN=
